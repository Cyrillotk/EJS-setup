<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/users">Users</a>
    </nav>

    <div class="container">
        <h1>Users</h1>

        <ul class="user-list">
            <% users.forEach(user => { %>

                <li class="user-card">
                    <h2><%= user.name %></h2>
                    <p>Email: <%= user.email %></p>
                    <p>Role: <%= user.role %></p>
                </li>

            <% }) %>
        </ul>
    </div>

</body>
</html>